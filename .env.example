# Runtime: local works without provider keys; cloud requires configured services
RAG_MODE=local

# Groq models
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=

# Portkey: slugs must match integrations in your account
PORTKEY_API_KEY=
PORTKEY_PRIMARY_SLUG=rag
PORTKEY_FALLBACK_SLUG=rag-fallback
# Optional saved configuration used by a notebook experiment
PORTKEY_CONFIG_ID=

# Cloud embeddings: choose the same backend for ingestion and queries.
# Changing backend requires a separate collection indexed with that backend.
RAG_EMBEDDING_BACKEND=gemini
# Gemini requires this key; explicit local uses all-mpnet-base-v2 (768 dimensions).
GEMINI_API_KEY=

# Qdrant: set the collection to an existing name to reuse its vectors
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_COLLECTION=rag

# Observability
LOGFIRE_TOKEN=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag

# UI backend
BACKEND_URL=http://localhost:8000

# Separate evaluation judge key
JUDGE_GROQ=

# Optional NVIDIA guardrail notebook experiment
NVIDIA_API_KEY=
